# Nivesh backend — environment variables
# Copy to .env and fill in real values before starting the server.
# NEVER commit .env to git — it contains real credentials.
#
# For Docker: docker run --env-file .env nivesh-backend
# For systemd: EnvironmentFile=/path/to/.env in the unit file

# ── Tier 2 / 3 AI — Anthropic (Haiku + Sonnet) ───────────────────────────────
# Haiku 4.5  → Research Manager, Portfolio Manager, Morning Brief
# Sonnet 4.6 → reformat_with_claude, PDF portfolio report writer
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Tier 1 AI — DeepSeek V4 Flash (bulk agent tasks) ─────────────────────────
# Used for: all LangGraph agent nodes (Market, News, Fundamentals, Sentiment,
#           Bull, Bear, Trader, Debaters), smart cache gate, red flags summary,
#           trade journal patterns, daily action, advisor stance extraction.
# Endpoint: https://api.deepseek.com/v1  (OpenAI-compatible)
# Get from: https://platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-key-here

# ── Market Data Scraping — Firecrawl ─────────────────────────────────────────
# Primary scraper for Screener.in, NSE, Moneycontrol structured extraction.
# Falls back to direct requests/BeautifulSoup when absent.
# Get from: https://www.firecrawl.dev
FIRECRAWL_API_KEY=fc-your-key-here

# ── YouTube Intelligence ──────────────────────────────────────────────────────
# Used by advisor_harvester.py to list channel videos via YouTube Data API v3.
# Falls back to yt-dlp when absent.
# Get from: https://console.cloud.google.com → YouTube Data API v3
YOUTUBE_API_KEY=AIza-your-key-here

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local dev — default if DATABASE_URL is unset):
DATABASE_URL=sqlite:///./stockapp.db
# PostgreSQL (production — replace password and host):
# DATABASE_URL=postgresql://nivesh:CHANGEME_STRONG_PASSWORD@localhost:5432/nivesh_db

# ── Backups (services/backup_service.py, scripts/backup_db.py) ───────────────
# Nightly 2:30 AM IST copy of stockapp.db + harvester.db (pg_dump for Postgres and
# the RAG DB). See docs/codebase/BACKUP_RESTORE.md.
# Backup folder; must stay OUTSIDE the git checkout. Default: ~/nivesh-backups
# BACKUP_DIR=/home/saumyapatel/nivesh-backups
# Copies kept per datastore (default 14, minimum 1):
# BACKUP_KEEP=14
# Dead-man switch, pinged on success and <url>/fail on failure (e.g. healthchecks.io):
# BACKUP_HEARTBEAT_URL=https://hc-ping.com/your-check-uuid

# ── Security ──────────────────────────────────────────────────────────────────
# JWT signing secret — generate a fresh one per deployment:
# python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_random_64_hex_string

# Legacy alias kept for backwards compat
SECRET_KEY=change_this_to_a_random_hex_string

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Lock down in production:
# ALLOWED_ORIGINS=http://192.168.1.97,https://yourdomain.com
ALLOWED_ORIGINS=*

# ── Environment ───────────────────────────────────────────────────────────────
# "development" or "production"
ENVIRONMENT=development

# Seed illustrative mutual-fund / IPO / loan-offer / FD catalogs at startup.
# Dev/demo servers only — keep false in production.
DEMO_MODE=false

# Public URL of this server (used in links, not for internal binding)
SERVER_URL=http://localhost:8000
