# Nivesh backend — environment variables
# Copy to .env and fill in real values before starting the server.
# NEVER commit .env to git.

# ── Required ─────────────────────────────────────────────────────────────────

# Anthropic API key (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Database URL
# SQLite (local dev):
DATABASE_URL=sqlite:///./stockapp.db
# PostgreSQL (production — replace password and host):
# DATABASE_URL=postgresql://nivesh:CHANGEME_STRONG_PASSWORD@localhost:5432/nivesh_db

# ── Security ─────────────────────────────────────────────────────────────────

# Random secret for internal signing
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_hex_string

# ── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated allowed origins, or * for all.
# Lock down in production: ALLOWED_ORIGINS=http://192.168.1.97,https://yourdomain.com
ALLOWED_ORIGINS=*

# ── Environment ──────────────────────────────────────────────────────────────

# "development" or "production"
ENVIRONMENT=development

# Public URL of this server (used in links, not for internal binding)
# On DigitalOcean: http://YOUR_DROPLET_IP:8000  or  https://yourdomain.com
SERVER_URL=http://localhost:8000
