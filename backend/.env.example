# Nivesh backend — environment variables
# Copy to .env and fill in real values before starting the server.
# NEVER commit .env to git — it contains real credentials.
#
# For Docker: docker run --env-file .env nivesh-backend
# For systemd: EnvironmentFile=/path/to/.env in the unit file

# ── Tier 2 / 3 AI — Anthropic (Haiku + Sonnet) ───────────────────────────────
# Haiku 4.5  → Research Manager, Portfolio Manager, Morning Brief
# Sonnet 4.6 → reformat_with_claude, PDF portfolio report writer
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Tier 1 AI — DeepSeek V4 Flash (bulk agent tasks) ─────────────────────────
# Used for: all LangGraph agent nodes (Market, News, Fundamentals, Sentiment,
#           Bull, Bear, Trader, Debaters), smart cache gate, red flags summary,
#           trade journal patterns, daily action, advisor stance extraction.
# Endpoint: https://api.deepseek.com/v1  (OpenAI-compatible)
# Get from: https://platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-key-here

# ── AI spend budgets (services/llm_budget.py) ────────────────────────────────
# USD per day (midnight to midnight IST), summed from the llm_usage ledger. At the
# global cap every paid AI call is refused (503); at a user's tier cap that user gets 429.
# LLM_GLOBAL_DAILY_BUDGET_USD=25
# LLM_USER_DAILY_BUDGET_USD_FREE=0.25
# LLM_USER_DAILY_BUDGET_USD_PRO=1.0
# LLM_USER_DAILY_BUDGET_USD_SUPER_PRO=3.0
# USD per 1M DeepSeek tokens (chat and reasoner). Unset = defaults in core/dashboard_state._PRICING_PER_M.
# LLM_PRICE_DEEPSEEK_IN=0.14
# LLM_PRICE_DEEPSEEK_OUT=0.28

# ── Market Data Scraping — Firecrawl ─────────────────────────────────────────
# Primary scraper for Screener.in, NSE, Moneycontrol structured extraction.
# Falls back to direct requests/BeautifulSoup when absent.
# Get from: https://www.firecrawl.dev
FIRECRAWL_API_KEY=fc-your-key-here

# ── YouTube Intelligence ──────────────────────────────────────────────────────
# Used by advisor_harvester.py to list channel videos via YouTube Data API v3.
# Falls back to yt-dlp when absent.
# Get from: https://console.cloud.google.com → YouTube Data API v3
YOUTUBE_API_KEY=AIza-your-key-here

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local dev — default if DATABASE_URL is unset):
DATABASE_URL=sqlite:///./stockapp.db
# PostgreSQL (production — replace password and host):
# DATABASE_URL=postgresql://nivesh:CHANGEME_STRONG_PASSWORD@localhost:5432/nivesh_db

# ── Backups (services/backup_service.py, scripts/backup_db.py) ───────────────
# Nightly 2:30 AM IST copy of stockapp.db + harvester.db (pg_dump for Postgres and
# the RAG DB). See docs/codebase/BACKUP_RESTORE.md.
# Backup folder; must stay OUTSIDE the git checkout. Default: ~/nivesh-backups
# BACKUP_DIR=/home/saumyapatel/nivesh-backups
# Copies kept per datastore (default 14, minimum 1):
# BACKUP_KEEP=14
# Dead-man switch, pinged on success and <url>/fail on failure (e.g. healthchecks.io):
# BACKUP_HEARTBEAT_URL=https://hc-ping.com/your-check-uuid

# ── Security ──────────────────────────────────────────────────────────────────
# JWT signing secret (>= 32 chars) — generate a fresh one per deployment:
# python3 -c "import secrets; print(secrets.token_hex(32))"
# In production the server refuses to start if this is empty or weak.
JWT_SECRET=

# Mock subscription purchases (POST /api/v1/subscription/upgrade). There is no
# StoreKit receipt verification, so leave this at 0 on real servers: "1" lets any
# account grant itself a paid tier. Local dev/demo only.
ALLOW_MOCK_PURCHASES=0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Empty is fine for the iOS-only API.
# Never '*' in production (the server refuses to start with it).
# ALLOWED_ORIGINS=http://192.168.1.97,https://yourdomain.com
ALLOWED_ORIGINS=

# ── Environment ───────────────────────────────────────────────────────────────
# "production" on servers; "development" (or "test") is for a local machine only.
# Unset counts as production (fail closed) and any other value refuses to start. Production means JWT/CORS checks,
# no API docs, no create_all, no dev push mock. Logs are JSON in production.
ENVIRONMENT=production

# OpenAPI/Swagger (/docs, /redoc, /openapi.json) are off unless enabled:
# ENABLE_API_DOCS=true

# Platform-wide cap on concurrent analysis/stress-test worker processes (default 6):
# MAX_CONCURRENT_JOBS=6
# Per-account cap on active analysis + stress-test workers across all scan types
# (anonymous callers share one bucket); exceeding it returns 429 TOO_MANY_JOBS.
# MAX_JOBS_PER_USER=2

# Seed illustrative mutual-fund / IPO / loan-offer / FD catalogs at startup.
# Dev/demo servers only — keep false in production.
DEMO_MODE=false

# RBI policy reference values (no live feed). Update after every MPC meeting;
# leave unset and the app shows "N/A" instead of a stale rate.
# RBI_REPO_RATE_PCT=5.50
# RBI_REPO_RATE_AS_OF=2026-08-06
# RBI_POLICY_STANCE=Neutral

# Analysis price targets, upside, target bands, extreme-scan scenario prices and fair
# value, and the Excel export's Target columns are withheld unless this is true (REG-02).
# Turning it on also brings back /portfolio/timeframe-conflicts' personalised
# "Consider taking near-term gains / holding" text, which is Investment Adviser-type
# advice. Set it ONLY once a SEBI-registered RA (and IA, for the conflicts text) operates the app.
# ADVISORY_OUTPUT_ENABLED=false

# ── Price-alert push (APNs) ───────────────────────────────────────────────────
# In production startup logs CRITICAL unless all three credentials are set or
# alerts are switched off on purpose with ALERTS_PUSH_DISABLED=true.
# APNS_AUTH_KEY_PATH=/home/saumyapatel/secrets/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# Must equal the app bundle id, or APNs rejects every push (DeviceTokenNotForTopic).
# APNS_TOPIC=saumypatel.stockme
# "production" on the server; anything else uses the APNs sandbox.
# APNS_ENVIRONMENT=production
# ALERTS_PUSH_DISABLED=false

# ── Monitoring (docs/codebase/MONITORING.md) ──────────────────────────────────
# The 7 AM daily error digest is POSTed here as plain text (ntfy.sh compatible,
# e.g. https://ntfy.sh/<private-topic>). Unset = digest only goes to logs/.
# OPS_ALERT_WEBHOOK_URL=
# LOG_LEVEL=INFO

# ── Cache / RAG database ──────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379
# RAG_DB_HOST=127.0.0.1
# RAG_DB_NAME=nivesh
# RAG_DB_USER=
# RAG_DB_PASS=

# ── Transport / ml-engine ─────────────────────────────────────────────────────
# Interface uvicorn binds to (nivesh.service defaults to 127.0.0.1 behind the
# TLS proxy). Set the private interface only if the proxy runs on another host.
# NIVESH_BIND_HOST=127.0.0.1

# Shared secret the backend sends to ml-engine as X-ML-Engine-Key. The ml-engine
# deploy script hands the same value to the container. Generate with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
ML_ENGINE_API_KEY=
# ML_ENGINE_URL=http://localhost:8001

# ── Grievance Officer (REG-12) ──────────────────────────────────────────────
# Shown in the Privacy Policy, Terms of Use and Settings > Contact & Grievance
# Officer (DPDP Rules / IT Rules 2021). Unset shows "to be published".
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=

# ── Feature flags (core/feature_flags.py, GET /api/v1/features) ─────────────
# 1/true/yes/on or 0/false/no/off; unset or any other value = the default shown.
# Loaded at startup: change a value here and restart the backend; no App Store release.
# Enable conditions for the off-by-default money flags: docs/money/FEATURE_FLAGS.md.
# My position screen and GET /api/v1/me/holdings/{ticker}
FEATURE_MONEY_HOLDING_DETAIL=true
# Portfolio XIRR and per-holding return card
FEATURE_MONEY_XIRR_CARD=true
# Journal entries scored against the Nifty 50 (shown only while the research engine is on)
FEATURE_MONEY_JOURNAL_SCORING=true
# CAMS/KFintech CAS PDF import of mutual-fund balances
FEATURE_MONEY_CAS_IMPORT=false
# Cross-broker portfolio X-ray screen
FEATURE_MONEY_XRAY=false
# Regular-plan vs direct-plan expense-ratio card inside the X-ray
FEATURE_MONEY_COMMISSION_DRAG=false
# FY capital-gains working for listed shares; keep off until CA sign-off
FEATURE_MONEY_TAX_REPORT=false
# COVID-2020 crash replay of current holdings
FEATURE_MONEY_CRISIS_REPLAY=false

# ── Data feeds (spec_data 0.1; core/feature_flags.py, same override syntax) ──
# FEATURE_<KEY>=true|false, loaded at startup. Defaults are shown.
# Weekly NSE EQUITY_L refresh and new-listing search
# FEATURE_DATA_INSTRUMENTS=true
# EOD mirror from ml-engine (needs ML_ENGINE_API_KEY)
# FEATURE_DATA_EOD_PRICES=true
# Return NSE EQ / Nifty closes to users; keep off until legal clears NSE data rights
# FEATURE_DATA_EOD_DISPLAY=false
# AMFI harvest, real MF universe and NAV history
# FEATURE_DATA_MF_UNIVERSE=true
# Corporate-action proposals and API (Defer; stays off until docs/data/DATA_FEEDS.md conditions are met)
# FEATURE_DATA_CORP_ACTIONS_CONFIRM=false
# Results digest (Defer; stays off until docs/data/DATA_FEEDS.md conditions are met)
# FEATURE_DATA_RESULTS_DIGEST=false
# Test cohorts: comma-separated user ids who get the Defer features while the flag is off
# FEATURE_DATA_CORP_ACTIONS_CONFIRM_USERS=
# FEATURE_DATA_RESULTS_DIGEST_USERS=
