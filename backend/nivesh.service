[Unit]
Description=Nivesh Stock Analysis Backend
After=network.target

[Service]
Type=simple
User=saumyapatel
WorkingDirectory=/Users/saumya/Desktop/nivesh/backend
EnvironmentFile=/Users/saumya/Desktop/nivesh/backend/.env
ExecStart=/Users/saumya/Desktop/nivesh/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
